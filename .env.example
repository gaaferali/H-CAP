# Copy this file to .env beside docker-compose.yml.
# Never commit the resulting .env file or real production credentials.
DJANGO_SECRET_KEY=replace-with-a-random-unique-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=your-domain.example
CORS_ALLOWED_ORIGINS=https://your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
DJANGO_HSTS_SECONDS=31536000
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE=hcap_refresh
API_LOGIN_RATE=8/min
API_REFRESH_RATE=30/min
API_ANON_RATE=60/min
API_USER_RATE=600/min
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Africa/Khartoum
WEB_CONCURRENCY=1

POSTGRES_DB=hcap
POSTGRES_USER=hcap
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
